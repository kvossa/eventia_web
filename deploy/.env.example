# Eventia — production environment for deploy/vm-setup.sh + compose.yml
#
# Copy to deploy/.env on the VM and fill in every REPLACE_WITH_* value.
#   cp deploy/.env.example deploy/.env
# deploy/.env is git-ignored; never commit real secrets.

# ---------- required: the public origin ----------
# Bare IPv4 of the Oracle VM, no port. This is what Let's Encrypt issues a cert for.
PUBLIC_SITE_ADDRESS=https://REPLACE_WITH_PUBLIC_IP
# Same origin, consumed by the backend as CORS_ORIGINS and FRONTEND_URL.
PUBLIC_ORIGIN=https://REPLACE_WITH_PUBLIC_IP
# Contact address for expiry / revocation notices. Should be a real mailbox.
ACME_EMAIL=you@example.com

# ---------- required: secrets (generate with: openssl rand -hex 32) ----------
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_HEX

# ---------- database ----------
POSTGRES_DB=eventia
POSTGRES_USER=eventia

# ---------- proxy ----------
# 1 = exactly one trusted proxy hop (Caddy). Do not raise this casually: a higher
# value lets clients spoof X-Forwarded-For if anything else can reach the app.
TRUST_PROXY_HOPS=1

# ---------- first-run administrator ----------
# Used only by the seed script. SEED_ALLOW_DESTRUCTIVE stays false on the VM.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---------- optional ----------
# Swagger is off in production unless this is exactly "true".
ENABLE_API_DOCS=false
# How often the mail outbox is drained. There is no real SMTP; entries stay queued.
MAIL_DRAIN_INTERVAL_MS=15000
